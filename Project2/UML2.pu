@startuml

class Necromancer {
    {static} + MAX_UNDEAD: int

    - __name: str
    - __resources: ResourceManager
    - __undead: list[Undead]
    - __next_id: int

    + __init__(name: str, ...)
    + get_name(): str
    + get_resources(): ResourceManager
    + get_undead(): list[Undead]
    - __find_undead(id: int): Undead | None
    + summon(ritual: SummonRitual): Undead | None
    + dismiss(id: int): bool
    + level_up(id: int): bool
    + __str__(): str
}

class ResourceManager {
    - __resources: dict[str, Resource]

    + collect_resources(...)
    + has_resources(...): bool
    + spend_resources(...): bool
}

class Resource

class SummonRitual {
    - __name: str
    - __undead_name: str
    - __starting_health: int
    - __starting_power: int
    - __costs: dict[str, int]

    + can_perform(resourceManager: ResourceManager): bool
    + perform(resourceManager: ResourceManager): bool
    + summon(id: int): Undead
}

class Undead {
    - __id: int
    - __name: str
    - __health: int
    - __power: int
    - __level: int

    + level_up()
}

Necromancer "1" *-- "1" ResourceManager : owns
ResourceManager "1" *-- "5" Resource : manages

Necromancer "1" o-- "0..10" Undead : controls

Necromancer ..> SummonRitual : uses
SummonRitual ..> ResourceManager : uses
SummonRitual ..> Undead : creates

@enduml